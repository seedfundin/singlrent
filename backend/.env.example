# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# PostgreSQL (local Docker Compose defaults)
DATABASE_URL=postgresql://singlerent:singlerent@localhost:5433/singlerent?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication — use unique, long random values outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30
PASSWORD_HASH_ROUNDS=12

# Sensitive field encryption and external providers. Keep real values out of source control.
FIELD_ENCRYPTION_SECRET=replace-with-a-long-random-field-encryption-secret
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
CLOUDFLARE_ACCOUNT_ID=replace_with_your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=replace_with_your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace_with_your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=singlerent-media
CLOUDFLARE_R2_PUBLIC_URL=https://replace-with-your-public-r2-url.example

# Dojah NIN verification. Never expose DOJAH_SECRET_KEY to the browser.
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_WEBHOOK_SECRET=

# Google sign-in verification
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo
