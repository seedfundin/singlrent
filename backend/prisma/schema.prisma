generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  TENANT
  LANDLORD
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum PermissionKey {
  USERS_VIEW
  USERS_EDIT
  USERS_SUSPEND
  KYC_VIEW
  KYC_REVIEW
  LISTINGS_VIEW
  LISTINGS_APPROVE
  LISTINGS_REJECT
  LISTINGS_SUSPEND
  TRANSACTIONS_VIEW
  ESCROW_MANAGE
  PAYOUTS_RELEASE
  REFUNDS_PROCESS
  PLATFORM_FEES_VIEW
  AGENT_COMMISSIONS_VIEW
  REPORTS_VIEW
  REPORTS_INVESTIGATE
  REPORTS_RESOLVE
  MAINTENANCE_MANAGE
  REVIEWS_VIEW
  REVIEWS_MODERATE
  ADMINS_CREATE
  ADMIN_PERMISSIONS_EDIT
  AUDIT_LOGS_VIEW
  SYSTEM_SETTINGS_MODIFY
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

// A Dojah record must identify the same person named on the SingleRent
// account. Raw provider names are not retained; this records only the outcome
// of the comparison so an exception can be reviewed safely.
enum IdentityNameMatchStatus {
  NOT_CHECKED
  MATCHED
  MISMATCHED
  UNAVAILABLE
}

// This is separate from a tenant's transactional KYC. It is the one-time
// verification an account must complete before it can publish a property.
enum PublisherVerificationMethod {
  NIN
  BVN
}

enum PublisherVerificationStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  FAILED
}

enum VerificationServiceChargeSource {
  TENANT_PAYMENT
  PAYOUT_DEDUCTION
}

enum VerificationServiceChargeStatus {
  PENDING_PAYMENT
  PROCESSING
  VERIFIED
  REJECTED
  FAILED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum ListingAvailability {
  AVAILABLE
  RENTED
  UNAVAILABLE
}

enum InspectionStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum InspectionMode {
  WEEKLY
  SPECIFIC_DATES
  BY_REQUEST
}

model InspectionAvailability {
  id                  String         @id @default(uuid()) @db.Uuid
  listingId           String         @unique @db.Uuid
  mode                InspectionMode @default(BY_REQUEST)
  timezone            String         @default("Africa/Lagos") @db.VarChar(100)
  durationMinutes     Int            @default(30)
  automaticConfirmation Boolean      @default(false)
  windows             Json
  updatedAt           DateTime       @updatedAt

  @@map("inspection_availability")
}

model InspectionBooking {
  id              String           @id @default(uuid()) @db.Uuid
  listingId       String           @db.Uuid
  tenantId        String           @db.Uuid
  hostId          String           @db.Uuid
  landlordId      String?          @db.Uuid
  agentId         String?          @db.Uuid
  hostCompletedAt DateTime?
  tenantConfirmedAt DateTime?
  tenantDisputedAt DateTime?
  reviews         Review[]
  startsAt        DateTime
  endsAt          DateTime
  status          InspectionStatus @default(PENDING)
  requestedById   String           @db.Uuid
  proposedStartsAt DateTime?
  proposedEndsAt   DateTime?
  proposedById     String?         @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([hostId, status, startsAt])
  @@index([listingId, status, startsAt])
  @@index([tenantId, createdAt])
  @@map("inspection_bookings")
}

enum ListingSource {
  LANDLORD
  AGENT
}

enum ListingMediaType {
  IMAGE
  VIDEO
}

enum PropertyType {
  APARTMENT
  HOUSE
  DUPLEX
  STUDIO
  ROOM
  OTHER
}

enum ApplicationStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_HELD
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum TenancyStatus {
  PENDING_MOVE_IN
  ACTIVE
  ENDED
  CANCELLED
}

enum GuarantorFormStatus {
  PENDING_SIGNATURE
  EXECUTED
}

enum GuarantorSignatureMethod {
  ELECTRONIC_CONSENT
  UPLOADED_SIGNED_COPY
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
  REFUNDED
}

enum EscrowStatus {
  HELD
  READY_FOR_RELEASE
  RELEASE_SCHEDULED
  RELEASED
  DISPUTED
  REFUNDED
  PARTIALLY_SETTLED
}

enum CautionStatus {
  NOT_APPLICABLE
  HELD
  DEDUCTION_PROPOSED
  DISPUTED
  SETTLED
  REFUNDED
}

enum CautionDeductionOutcome {
  LANDLORD_PAID
  TENANT_REFUND
}

enum PayoutKind {
  LANDLORD
  AGENT
  CAUTION_DEDUCTION
  CAUTION_REFUND
  REFUND
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum LedgerAccountCode {
  PAYMENT_CLEARING
  RENT_ESCROW
  CAUTION_ESCROW
  PLATFORM_REVENUE
  LEGAL_FEE_REVENUE
  AGENT_PAYABLE
  LANDLORD_PAYABLE
  TENANT_REFUND_PAYABLE
}

enum LedgerEntryType {
  PAYMENT_CONFIRMED
  RENT_ESCROW_HELD
  CAUTION_ESCROW_HELD
  PLATFORM_FEE_ALLOCATED
  LEGAL_FEE_ALLOCATED
  AGENT_COMMISSION_ALLOCATED
  LANDLORD_PAYOUT_ALLOCATED
  CAUTION_REFUND_ALLOCATED
  CAUTION_DEDUCTION_ALLOCATED
  PAYOUT_COMPLETED
  PAYMENT_REVERSED
  REFUND_ISSUED
  CANCELLATION_FEE_ALLOCATED
  PLATFORM_FEE_REFUNDED
  LEGAL_FEE_REFUNDED
  AGENT_FEE_REFUNDED
  KYC_SERVICE_FEE_ALLOCATED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICITY
  APPLIANCE
  SECURITY
  STRUCTURAL
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ConversationType {
  LISTING_ENQUIRY
  PROPERTY_AI
  TENANCY
  SUPPORT
}

enum MessageKind {
  USER
  SYSTEM
  AI
}

enum NotificationType {
  INSPECTION_UPDATED
  REVIEW_UPDATED
  VERIFICATION_UPDATED
  TENANCY_UPDATED
  ADMIN_ANNOUNCEMENT
  NEW_MESSAGE
  NEW_APPLICATION
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  ESCROW_UPDATED
  COMMISSION_EARNED
  MAINTENANCE_CREATED
  MAINTENANCE_UPDATED
  LISTING_STATUS_UPDATED
  KYC_UPDATED
  INCIDENT_UPDATED
  CAUTION_DISPUTE_UPDATED
  ADMIN_INVITATION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum IncidentType {
  SAFETY_THREAT
  HARASSMENT
  FRAUD
  VIOLENCE
  SERIOUS_PROPERTY_SAFETY
  MISCONDUCT
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ReviewTargetType {
  LISTING
  LANDLORD
  AGENT
  TENANT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum AgreementStatus {
  PENDING_SIGNATURES
  PARTIALLY_SIGNED
  EXECUTED
  SUPERSEDED
  VOID
}

enum AgreementSignerRole {
  TENANT
  LANDLORD
  AGENT
}

enum AgreementSignatureMethod {
  ELECTRONIC_CONSENT
  UPLOADED_SIGNED_COPY
}

enum ReceiptKind {
  TENANT_PAYMENT_CONFIRMED
  LANDLORD_PAYOUT_DISBURSED
}

model User {
  id                         String                       @id @default(uuid()) @db.Uuid
  email                      String?                      @unique @db.VarChar(320)
  firstName                  String                       @db.VarChar(100)
  lastName                   String                       @db.VarChar(100)
  passwordHash               String?                      @db.VarChar(255)
  phone                      String?                      @unique @db.VarChar(32)
  phoneVerifiedAt            DateTime?
  emailVerifiedAt            DateTime?
  profileImageUrl            String?                      @db.Text
  profileImagePublicId       String?                      @db.VarChar(255)
  bio                        String?                      @db.VarChar(1000)
  status                     UserStatus                   @default(ACTIVE)
  lastActiveAt               DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  kyc                        KycProfile?
  publisherVerification      PublisherVerification?
  publisherVerificationAttempts PublisherVerificationAttempt[]
  tenantProfile              TenantProfile?
  landlordProfile            LandlordProfile?
  agentProfile               AgentProfile?
  payoutAccount              PayoutAccount?
  userRoles                  UserRole[]
  directPermissions          UserPermission[]
  refreshTokens              RefreshToken[]
  emailChallenges            EmailVerificationChallenge[]
  passwordResetChallenges    PasswordResetChallenge[]
  phoneChallenges            PhoneVerificationChallenge[]
  verificationServiceCharges VerificationServiceCharge[]
  savedListings              SavedListing[]
  listingsOwned              Listing[]                    @relation("ListingLandlord")
  listingsCreated            Listing[]                    @relation("ListingCreator")
  listingsManaged            Listing[]                    @relation("ListingAgent")
  applicationsAsTenant       RentalApplication[]          @relation("ApplicationTenant")
  applicationsAsLandlord     RentalApplication[]          @relation("ApplicationLandlord")
  applicationsAsAgent        RentalApplication[]          @relation("ApplicationAgent")
  tenanciesAsTenant          Tenancy[]                    @relation("TenancyTenant")
  tenanciesAsLandlord        Tenancy[]                    @relation("TenancyLandlord")
  tenanciesAsAgent           Tenancy[]                    @relation("TenancyAgent")
  paymentsAsTenant           Payment[]                    @relation("PaymentTenant")
  paymentsAsLandlord         Payment[]                    @relation("PaymentLandlord")
  paymentsAsAgent            Payment[]                    @relation("PaymentAgent")
  payoutRecipients           Payout[]                     @relation("PayoutRecipient")
  maintenanceReported        MaintenanceRequest[]         @relation("MaintenanceReporter")
  maintenanceForLandlord     MaintenanceRequest[]         @relation("MaintenanceLandlord")
  maintenanceForAgent        MaintenanceRequest[]         @relation("MaintenanceAgent")
  maintenanceAssigned        MaintenanceRequest[]         @relation("MaintenanceAssignee")
  maintenanceCasesOwned      MaintenanceRequest[]         @relation("MaintenanceAdminOwner")
  maintenanceUpdates         MaintenanceUpdate[]
  conversationMemberships    ConversationMember[]
  messagesSent               Message[]                    @relation("MessageSender")
  questionsAsTenant          PropertyQuestionEscalation[] @relation("QuestionTenant")
  questionsAsContact         PropertyQuestionEscalation[] @relation("QuestionContact")
  messageReceipts            MessageReceipt[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  pushDevices                PushDevice[]
  reviewsWritten             Review[]                     @relation("ReviewAuthor")
  reviewsReceived            Review[]                     @relation("ReviewTargetUser")
  agreementSignatures        AgreementSignature[]
  guarantorFormsSubmitted    GuarantorForm[]              @relation("GuarantorFormSubmittedBy")
  receipts                   Receipt[]                    @relation("ReceiptRecipient")
  incidentsReported          IncidentReport[]             @relation("IncidentReporter")
  incidentsAssigned          IncidentReport[]             @relation("IncidentAssignee")
  auditLogs                  AuditLog[]                   @relation("AuditLogActor")
  invitationsSent            AdminInvitation[]            @relation("AdminInvitationSender")
  invitationAccepted         AdminInvitation?             @relation("AdminInvitationAccepted")

  @@map("users")
}

model KycProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  ninCiphertext     String?   @db.Text
  ninLast4          String?   @db.Char(4)
  identityMethod    PublisherVerificationMethod?
  ninStatus         KycStatus @default(NOT_STARTED)
  phoneStatus       KycStatus @default(NOT_STARTED)
  status            KycStatus @default(NOT_STARTED)
  nameMatchStatus   IdentityNameMatchStatus @default(NOT_CHECKED)
  nameMatchReason   String?   @db.VarChar(1000)
  providerReference String?   @unique @db.VarChar(255)
  rejectionReason   String?   @db.VarChar(1000)
  reviewedByUserId  String?   @db.Uuid
  reviewedAt        DateTime?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("kyc_profiles")
}

model PublisherVerification {
  id                       String                       @id @default(uuid()) @db.Uuid
  userId                   String                       @unique @db.Uuid
  method                   PublisherVerificationMethod?
  status                   PublisherVerificationStatus  @default(NOT_STARTED)
  providerReference        String?                      @unique @db.VarChar(255)
  providerVerificationType String?                      @db.VarChar(100)
  providerStatus           String?                      @db.VarChar(100)
  livenessVerified         Boolean                      @default(false)
  nameMatchStatus          IdentityNameMatchStatus     @default(NOT_CHECKED)
  nameMatchReason          String?                     @db.VarChar(1000)
  failureReason            String?                      @db.VarChar(1000)
  requestedAt              DateTime?
  completedAt              DateTime?
  verifiedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts                 PublisherVerificationAttempt[]

  @@index([status, requestedAt])
  @@map("publisher_verifications")
}

// A current verification record drives account access. Attempts preserve every
// provider reference for reconciliation and ensure a delayed webhook for an
// older, billable session cannot overwrite the current result.
model PublisherVerificationAttempt {
  id                       String                      @id @default(uuid()) @db.Uuid
  verificationId           String                      @db.Uuid
  userId                   String                      @db.Uuid
  method                   PublisherVerificationMethod
  status                   PublisherVerificationStatus @default(PENDING)
  providerReference        String                      @unique @db.VarChar(255)
  providerVerificationType String?                     @db.VarChar(100)
  providerStatus           String?                     @db.VarChar(100)
  livenessVerified         Boolean                     @default(false)
  nameMatchStatus          IdentityNameMatchStatus    @default(NOT_CHECKED)
  nameMatchReason          String?                    @db.VarChar(1000)
  failureReason            String?                     @db.VarChar(1000)
  requestedAt              DateTime                    @default(now())
  completedAt              DateTime?
  verifiedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  verification             PublisherVerification       @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([verificationId, requestedAt])
  @@map("publisher_verification_attempts")
}

model TenantProfile {
  userId           String   @id @db.Uuid
  occupation       String?  @db.VarChar(150)
  defaultOccupants Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model LandlordProfile {
  userId              String   @id @db.Uuid
  businessName        String?  @db.VarChar(200)
  payoutRecipientCode String?  @db.VarChar(255)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_profiles")
}

model AgentProfile {
  userId              String    @id @db.Uuid
  companyName         String?   @db.VarChar(200)
  licenceNumber       String?   @unique @db.VarChar(100)
  dateOfBirth         DateTime? @db.Date
  payoutRecipientCode String?   @db.VarChar(255)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

// The raw bank-account number is deliberately never stored. Paystack returns a
// recipient code after validating the destination; that code plus the masked
// display fields are all SingleRent needs for future transfers and refunds.
model PayoutAccount {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @unique @db.Uuid
  provider      PaymentProvider @default(PAYSTACK)
  // A bank destination may legitimately be shared by more than one user
  // (for example, a joint household or a test account). The user relation is
  // still unique, while the provider recipient code is indexed for transfers.
  recipientCode String          @db.VarChar(255)
  bankCode      String          @db.VarChar(32)
  bankName      String          @db.VarChar(180)
  accountName   String          @db.VarChar(255)
  accountLast4  String          @db.Char(4)
  currency      String          @default("NGN") @db.Char(3)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, recipientCode])
  @@map("payout_accounts")
}

model PhoneVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  phone      String    @db.VarChar(32)
  codeHash   String    @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("phone_verification_challenges")
}

model EmailVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  email      String    @db.VarChar(320)
  codeHash   String    @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_challenges")
}

// This legacy table is retained so an older deployed database can be migrated
// safely. New authentication OTPs use PhoneVerificationChallenge instead.
// Password resets never verify or change a contact email address.
model PasswordResetChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  codeHash    String    @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_challenges")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         PermissionKey    @unique
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  assignedAt   DateTime         @default(now())
  assignedBy   String?          @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.VarChar(500)
  ipAddress String?   @db.VarChar(64)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Listing {
  id                  String               @id @default(uuid()) @db.Uuid
  slug                String               @unique @db.VarChar(180)
  title               String               @db.VarChar(200)
  description         String               @db.Text
  propertyType        PropertyType
  source              ListingSource        @default(LANDLORD)
  status              ListingStatus        @default(DRAFT)
  availability        ListingAvailability  @default(AVAILABLE)
  annualRentKobo      BigInt
  serviceChargeKobo   BigInt               @default(0)
  cautionFeeKobo      BigInt               @default(0)
  bedrooms            Int
  bathrooms           Int
  state               String               @db.VarChar(100)
  area                String               @db.VarChar(150)
  address             String               @db.VarChar(500)
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  amenities           String[]
  rules               Json?
  availableFrom       DateTime?
  minimumLeaseMonths  Int                  @default(12)
  publishedAt         DateTime?
  archivedAt          DateTime?
  moderationNote      String?              @db.VarChar(1000)
  moderatedByUserId   String?              @db.Uuid
  landlordId          String               @db.Uuid
  createdById         String               @db.Uuid
  managingAgentId     String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  landlord            User                 @relation("ListingLandlord", fields: [landlordId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("ListingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  managingAgent       User?                @relation("ListingAgent", fields: [managingAgentId], references: [id], onDelete: SetNull)
  media               ListingMedia[]
  savedBy             SavedListing[]
  applications        RentalApplication[]
  tenancies           Tenancy[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  conversations       Conversation[]
  reviews             Review[]
  incidents           IncidentReport[]

  @@index([status, availability, state, area])
  @@index([annualRentKobo])
  @@index([landlordId, status])
  @@index([managingAgentId, status])
  @@map("listings")
}

model ListingMedia {
  id        String           @id @default(uuid()) @db.Uuid
  listingId String           @db.Uuid
  url       String           @db.Text
  objectKey String           @unique @db.VarChar(500)
  mediaType ListingMediaType
  altText   String?          @db.VarChar(255)
  mimeType  String           @db.VarChar(100)
  width     Int?
  height    Int?
  bytes     Int?
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@index([listingId, mediaType])
  @@map("listing_media")
}

model SavedListing {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
