  id              String      @id @default(uuid()) @db.Uuid
  receiptNumber   String      @unique @db.VarChar(64)
  kind            ReceiptKind
  paymentId       String      @db.Uuid
  payoutId        String?     @db.Uuid
  recipientUserId String      @db.Uuid
  issuedAt        DateTime    @default(now())
  voidedAt        DateTime?
  metadata        Json
  payment         Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payout          Payout?     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  recipient       User        @relation("ReceiptRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([paymentId, kind])
  @@unique([payoutId, kind])
  @@index([recipientUserId, issuedAt])
  @@map("receipts")
}

model IncidentReport {
  id               String             @id @default(uuid()) @db.Uuid
  reference        String             @unique @db.VarChar(40)
  reporterId       String             @db.Uuid
  listingId        String?            @db.Uuid
  assignedToUserId String?            @db.Uuid
  type             IncidentType
  severity         IncidentSeverity
  description      String             @db.Text
  occurredAt       DateTime?
  confidential     Boolean            @default(true)
  status           IncidentStatus     @default(SUBMITTED)
  resolutionNote   String?            @db.VarChar(2000)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  reporter         User               @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  listing          Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation("IncidentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  evidence         IncidentEvidence[]

  @@index([status, severity, createdAt])
  @@index([reporterId, createdAt])
  @@map("incident_reports")
}

model IncidentEvidence {
  id               String         @id @default(uuid()) @db.Uuid
  incidentReportId String         @db.Uuid
  url              String         @db.Text
  publicId         String         @unique @db.VarChar(255)
  format           String?        @db.VarChar(30)
  bytes            Int?
  createdAt        DateTime       @default(now())
  incidentReport   IncidentReport @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)

  @@index([incidentReportId])
  @@map("incident_evidence")
}

model AdminInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(320)
  tokenHash        String    @unique @db.Char(64)
  role             RoleCode  @default(ADMIN)
  adminTitle       String?   @db.VarChar(150)
  invitedByUserId  String    @db.Uuid
  acceptedByUserId String?   @unique @db.Uuid
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  invitedBy        User      @relation("AdminInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?     @relation("AdminInvitationAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("admin_invitations")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(150)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(128)
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
