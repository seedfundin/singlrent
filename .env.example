# Browser-safe Google Maps Platform key. Restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-your-restricted-google-maps-key

# Dojah EasyOnboard publisher verification widget. These values are browser-safe,
# but use your own sandbox or production configuration in local environment files.
NEXT_PUBLIC_DOJAH_APP_ID=replace-with-your-dojah-app-id
NEXT_PUBLIC_DOJAH_PUBLIC_KEY=replace-with-your-dojah-public-key
NEXT_PUBLIC_DOJAH_PUBLISHER_WIDGET_ID=replace-with-your-dojah-widget-id

# Local Nest API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional override for the Socket.IO server. It defaults to the API host.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Browser push (public Firebase project settings; build-time values).
# Keep delivery disabled on the backend until the complete implementation has
# been tested with real devices and the migration has been applied.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
